[Unit]
Description=Telegram alert monitor
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/alert-monitor
EnvironmentFile=/home/deploy/alert-monitor/.env
ExecStart=/home/deploy/alert-monitor/venv/bin/python -u -m alertbot.monitor
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
